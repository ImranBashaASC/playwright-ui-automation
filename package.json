{
  "name": "playwright-enterprise-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright UI Automation Framework",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:parallel": "npx playwright test",
    "test:ui": "npx playwright test --ui",
    "test:debug": "npx playwright test --debug",
    "test:smoke": "npx playwright test --grep @Smoke",
    "test:regression": "npx playwright test --grep @Regression",
    "test:sanity": "npx playwright test --grep @Sanity",
    "test:e2e": "npx playwright test --grep @E2E",
    "test:single": "npx playwright test tests/login.spec.ts",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:qa": "cross-env test_env=qa npm test",
    "test:dev": "cross-env test_env=dev npm test",
    "test:uat": "cross-env test_env=uat npm test",
    "report:show": "npx playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.ts\"",
    "ci:test": "npm test"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "framework"
  ],
  "author": "Lead Quality Engineering Automation Architect",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.42.1",
    "@types/node": "^18.19.24",
    "@types/papaparse": "^5.3.14",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "allure-commandline": "^2.27.0",
    "allure-playwright": "^2.15.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^1.5.2",
    "eslint-plugin-prettier": "^5.1.3",
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "winston": "^3.12.0"
  }
}
