
{
  "name": "playwright-ui-automation",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright UI Automation Framework",
  "main": "index.js",
  "scripts": {
    "test": "cross-env test_env=qa npx playwright test",
    "test:headed": "cross-env test_env=qa npx playwright test --headed",
    "test:parallel": "cross-env test_env=qa npx playwright test",
    "test:single": "cross-env test_env=qa npx playwright test tests/login.spec.ts",
    "test:smoke": "cross-env test_env=qa npx playwright test --grep @Smoke",
    "test:regression": "cross-env test_env=qa npx playwright test --grep @Regression",
    "test:sanity": "cross-env test_env=qa npx playwright test --grep @Sanity",
    "test:accessibility": "cross-env test_env=qa npx playwright test --grep @Accessibility",
    "test:e2e": "cross-env test_env=qa npx playwright test --grep @E2E",
    "test:critical": "cross-env test_env=qa npx playwright test --grep @Critical",
    "test:qa": "cross-env test_env=qa npx playwright test",
    "test:dev": "cross-env test_env=dev npx playwright test",
    "test:uat": "cross-env test_env=uat npx playwright test",
    "test:chromium": "cross-env test_env=qa npx playwright test --project=chromium",
    "test:firefox": "cross-env test_env=qa npx playwright test --project=firefox",
    "test:webkit": "cross-env test_env=qa npx playwright test --project=webkit",
    "report:show": "npx playwright show-report reports/html",
    "report:allure": "allure generate ./reports/allure-results --clean && allure open ./allure-report",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "ci:test": "npx playwright test"
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "testing",
    "ui"
  ],
  "author": "Lead Quality Engineering Automation Architect",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.1",
    "@types/node": "^20.10.4",
    "@types/papaparse": "^5.3.14",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2",
    "allure-commandline": "^2.25.0",
    "allure-playwright": "^2.10.0",
    "axe-playwright": "^2.0.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^0.20.0",
    "eslint-plugin-prettier": "^5.0.1",
    "papaparse": "^5.4.1",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "winston": "^3.11.0",
    "xlsx": "^0.18.5"
  }
}
