{
  "name": "playwright-ui-automation",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright UI Automation Framework",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:smoke": "npx playwright test --grep @Smoke",
    "test:regression": "npx playwright test --grep @Regression",
    "test:sanity": "npx playwright test --grep @Sanity",
    "test:e2e": "npx playwright test --grep @E2E",
    "test:acc": "npx playwright test --grep @Accessibility",
    "test:qa": "cross-env ENV=qa npm test",
    "test:dev": "cross-env ENV=dev npm test",
    "test:uat": "cross-env ENV=uat npm test",
    "test:parallel": "npx playwright test",
    "test:single": "npx playwright test tests/e2e/login.spec.ts",
    "test:chromium": "npx playwright test --project=chromium",
    "report:show": "npx playwright show-report reports/html",
    "allure:report": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.ts\""
  },
  "keywords": [
    "playwright",
    "typescript",
    "automation",
    "framework"
  ],
  "author": "Lead Quality Engineering Automation Architect",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^18.11.18",
    "@types/papaparse": "^5.3.7",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "allure-commandline": "^2.24.1",
    "allure-playwright": "^2.9.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "exceljs": "^4.4.0",
    "papaparse": "^5.4.1",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "winston": "^3.11.0"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.8.2"
  }
}
